{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": false,
        "outDir": "dist",
        "rootDir": "src",
        "rewriteRelativeImportExtensions": true,
        "declaration": true
    },
    "include": [
        "src/index.ts",
        "src/core/**/*.ts",
        "src/ocr/**/*.ts",
        "src/web/**/*.ts",
        "src/cli/**/*.ts"
    ]
}
