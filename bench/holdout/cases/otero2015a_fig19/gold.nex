        Camelotia
        Antetonitrus
        Lessemsaurus
        Blikanasaurus
        Gongxianosaurus
        Isanosaurus
        Tazoudasaurus
        Vulcanodon
        Eusauropoda
    ;
END;

BEGIN TREES;
    TREE otero2015a_fig19 = [&R] (basalmost_sauropodomorphs,(Jingshanosaurus,(Yunnanosaurus,(Seitaad,(Anchisaurus,(Mussaurus,(Sefapanosaurus,(Aardonyx,(Leonerasaurus,(Melanorosaurus,(Camelotia,((Antetonitrus,Lessemsaurus),(Blikanasaurus,(Gongxianosaurus,(Isanosaurus,(Tazoudasaurus,(Vulcanodon,Eusauropoda)))))))))))))))));
END;
