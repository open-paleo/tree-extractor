        Alaskacephale_gangloffi
        Goyocephale_lattimorei
        Wannanosaurus_yansiensis
        Yinlong_downsi
        Psittacosaurus_mongoliensis
    ;
END;

BEGIN TREES;
    TREE dyer2023a_fig21 = [&R] (((Colepiocephale_lambei,(Stegoceras_validum,(((Amtocephale_gobienses,Foraminacephale_brevis),(Sinocephale_bexelli,((Sphaerotholus_edmontonensis,Sphaerotholus_buchholtzae),((Sphaerotholus_goodwini,Pachycephalosaurus_wyomingensis),((Acrotholus_audeti,Prenocephale_prenes),Tylocephale_gilmorei))))),(Homalocephale_calathocercos,(Alaskacephale_gangloffi,Goyocephale_lattimorei))))),Wannanosaurus_yansiensis),Yinlong_downsi,Psittacosaurus_mongoliensis);
