        Oviraptorosauria
        Sinovenator_changii
        Anchiornis_huxleyi
        Mei_long
        Other_troodontids
        Dromaeosauridae
        Scansoriopterygidae
        Archaeopteryx
        Other_avians
    ;
END;

BEGIN TREES;
    TREE hu2009a_fig4 = [&R] (Coelophysoidea,(Ceratosauria,(Basal_tetanurans,(Tyrannosauroidea,(Compsognathidae,(Ornithomimosauria,(Ornitholestes_hermanni,(Therizinosauroidae,(Alvarezsauroidea,(Oviraptorosauria,(((Sinovenator_changii,(Anchiornis_huxleyi,(Mei_long,Other_troodontids))),Dromaeosauridae),(Scansoriopterygidae,(Archaeopteryx,Other_avians)))))))))))));
