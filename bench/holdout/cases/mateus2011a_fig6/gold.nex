        Barosaurus
        Diplodocus
    ;
END;

BEGIN TREES;
    TREE mateus2011a_fig6 = [&R] (Vulcanodon,(Shunosaurus,(Barapasaurus,((Omeisaurus,Mamenchisaurus),(Patagosaurus,(Jobaria,(Camarasaurus,((Brachiosaurus,(Angolatitan,(Euhelopus,(Malawisaurus,(Isisaurus,(Saltasaurus,(Alamosaurus,Opisthocoelicaudia))))Titanosauria))Somphospondyli)Titanosauriformes,(Nemegtosaurus,(Haplocanthosaurus,((Nigersaurus,Rayososaurus),((Dicraeosaurus,Amargasaurus),(Apatosaurus,(Barosaurus,Diplodocus)))))Diplodocoidea)))Neosauropoda))))))Sauropoda;
