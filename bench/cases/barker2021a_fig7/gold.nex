#NEXUS

[ barker2021a_fig7: Time-calibrated spinosaurid tree with continent icons and silhouettes, 15 tips. Matrix spellings: Wight_A and Wight_B are the printed Ceratosuchops and Riparovenator (sister taxa, so the pairing does not affect the topology; the matrix does not say which is which), ML_1190_cf_Baryonyx (printed ML 1190 cf. Baryonyx), Spinosaurus_B. Other_megalosauroids is a collapsed outgroup and keeps its printed text. Topology transcribed from the figure and checked node by node (2026-10-29); topology only. ]

BEGIN TAXA;
    DIMENSIONS NTAX=15;
    TAXLABELS
        Vallibonavenatrix
        Camarillasaurus
        Ichthyovenator
        Irritator
        Sigilmassasaurus
        Spinosaurus_B
        MSNM_V4047
        Spinosaurus_type
        FSAC_KK11888
        ML_1190_cf_Baryonyx
        Baryonyx
        Suchomimus
        Wight_A
        Wight_B
        Other_megalosauroids
    ;
END;

BEGIN TREES;
    TREE barker2021a_fig7 = [&R] ((Vallibonavenatrix,((Camarillasaurus,(Ichthyovenator,(Irritator,(Sigilmassasaurus,(Spinosaurus_B,(MSNM_V4047,(Spinosaurus_type,FSAC_KK11888))))))),((ML_1190_cf_Baryonyx,Baryonyx),(Suchomimus,(Wight_A,Wight_B))))),Other_megalosauroids);
END;
