BEGIN TREES;
    TREE sellés2021a_fig3 = [&R] (Geminiraptor,Hesperornithoides,(((Jianianhualong,(Sinovenator,(Xiaotingia,Mei))),(Jinfengopteryx,(Liaoningvenator,(Philovenator,(IGM1001128,IGM100140,Tamarro_insperatus))))),(IGM10044,(((Xixiasaurus,Sinusonasus),(Tochisaurus,Daliansaurus)),(Gobivenator,((Sinornithoides,Byronosaurus),(Zanabazar,Urbacodon_mandibular_only,(Saurornithoides,Borogovia),(Troodon_sensu_lato,(Linhevenator,Talos)))))))));
