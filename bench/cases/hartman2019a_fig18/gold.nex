BEGIN TREES;
    TREE hartman2019a_fig18 = [&R] (Compsognathidae,(Ornithomimosauria,((Alvarezsauroidea,Therizinosauria),(Protarchaeopteryx,(Oviraptorosauria,(((Serikornis,(Caihong,(Anchiornis,(Archaeopteryx,(Eosinopteryx,Aurornis))))),(((Halszkaraptor,(Mahakala,Ningyuansaurus)),((((Unenlagia_sensu_lato,Dakotaraptor),Rahonavis),Buitreraptor),Austroraptor)),((Tianyuraptor,(((Zhenyuanlong,(((Microraptor,Zhongjianosaurus),Sinornithosaurus),((Graciliraptor,Changyuraptor),NGMC91))),(Bambiraptor,Variraptor)),Eudromaeosauria)),((Mei,(Xiaotingia,(Sinovenator,Jianianhualong))),(Almas,Liaoningvenator,((Daliansaurus,(Hesperornithoides,Sinusonasus)),Derived_troodontids)))))),((Scansoriopteryx,(Yi,Epidexipteryx)),(Zhongornis,(Balaur,(Sapeornis,((jianchangensis,Zhongjianornis),(Jeholornithidae,(Confuciusornithidae,Ornithothoraces)))))))))))));
