#NEXUS

[ Maidment, Norman, Barrett & Upchurch 2008, J. Syst. Palaeontol., Fig. 11A: strict consensus of 5 MPTs, 18 taxa (panel A only, region 180,180-1200,1030 of the 300 dpi page scan). Numbers 1-8 and letters A-C in the figure are clade labels, not support. Topology transcribed by the tool and checked node by node against the image (2026-10-26). Taxon names as in Appendix 3. ]

BEGIN TAXA;
    DIMENSIONS NTAX=18;
    TAXLABELS
        Lesothosaurus
        Scutellosaurus
        Emausaurus
        Scelidosaurus
        Huayangosaurus
        Chungkingosaurus
        Dacentrurus_armatus
        Loricatosaurus
        Tuojiangosaurus
        Paranthodon
        Stegosaurus_homheni
        S._mjosi
        S._armatus
        Kentrosaurus
        Gigantspinosaurus
        Euoplocephalus
        Gastonia
        Sauropelta
    ;
END;

BEGIN TREES;
    TREE maidment2008a_fig11 = [&R] (Lesothosaurus,(Scutellosaurus,(Emausaurus,(Scelidosaurus,((((Huayangosaurus,Chungkingosaurus),(Dacentrurus_armatus,((Loricatosaurus,Tuojiangosaurus,Paranthodon,((Stegosaurus_homheni,S._mjosi),S._armatus)),Kentrosaurus))),Gigantspinosaurus),((Euoplocephalus,Gastonia),Sauropelta))))));
END;
